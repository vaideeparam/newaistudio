{
  "name": "newaistudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run src server",
    "build:demo": "node scripts/build-demo.mjs",
    "e2e": "npm run build:demo && node --test --test-concurrency=1 e2e/journeys.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@modelcontextprotocol/sdk": "1.32",
    "hono": "^4.13.22",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
