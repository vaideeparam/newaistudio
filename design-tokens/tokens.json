{
  "$description": "ai/Studio design tokens v0.1, extracted from index.html. Tokens with $extensions.guess = true are not on the landing page. Mirrors tokens.css.",
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Readex Pro", "sans-serif"], "$description": "Headings, logo, tabs" },
      "body": { "$type": "fontFamily", "$value": ["Oxygen", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "$extensions": { "guess": true } }
    },
    "weight": {
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500, "$description": "Readex Pro only" },
      "semibold": { "$type": "fontWeight", "$value": 600, "$description": "Readex Pro only" },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "15px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "32px" },
      "4xl": { "$type": "dimension", "$value": "42px" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.2 },
      "snug": { "$type": "number", "$value": 1.4 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    }
  },
  "color": {
    "brand": {
      "50": { "$type": "color", "$value": "rgba(80, 70, 229, 0.04)" },
      "100": { "$type": "color", "$value": "rgba(80, 70, 229, 0.08)" },
      "200": { "$type": "color", "$value": "rgba(80, 70, 229, 0.15)" },
      "500": { "$type": "color", "$value": "#5046e5", "$description": "Primary brand colour" },
      "600": { "$type": "color", "$value": "#4338ca", "$description": "Primary hover" },
      "700": { "$type": "color", "$value": "#3730a3", "$extensions": { "guess": true } }
    },
    "gray": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "25": { "$type": "color", "$value": "#fafafa" },
      "50": { "$type": "color", "$value": "#f8f8f8" },
      "75": { "$type": "color", "$value": "#f5f5f5" },
      "100": { "$type": "color", "$value": "#f0f0f0" },
      "200": { "$type": "color", "$value": "#e0e0e0" },
      "300": { "$type": "color", "$value": "#cccccc" },
      "500": { "$type": "color", "$value": "#777777" },
      "600": { "$type": "color", "$value": "#555555" },
      "700": { "$type": "color", "$value": "#333333" },
      "900": { "$type": "color", "$value": "#1a1a1a" },
      "1000": { "$type": "color", "$value": "#000000" }
    },
    "info": { "500": { "$type": "color", "$value": "#0d6efd" }, "50": { "$type": "color", "$value": "#f0f7ff" } },
    "success": { "500": { "$type": "color", "$value": "#28a745" }, "50": { "$type": "color", "$value": "#f0faf0" } },
    "danger": { "500": { "$type": "color", "$value": "#e53e3e" }, "50": { "$type": "color", "$value": "#fdf0f0", "$extensions": { "guess": true } } },
    "warning": { "500": { "$type": "color", "$value": "#d97706", "$extensions": { "guess": true } }, "50": { "$type": "color", "$value": "#fff8eb", "$extensions": { "guess": true } } },
    "role": {
      "bg": { "$type": "color", "$value": "{color.gray.25}" },
      "surface": { "$type": "color", "$value": "{color.gray.0}" },
      "surfaceMuted": { "$type": "color", "$value": "{color.gray.75}" },
      "text": { "$type": "color", "$value": "{color.gray.700}" },
      "textStrong": { "$type": "color", "$value": "{color.gray.900}" },
      "textSecondary": { "$type": "color", "$value": "{color.gray.600}" },
      "textMuted": { "$type": "color", "$value": "{color.gray.500}" },
      "border": { "$type": "color", "$value": "{color.gray.100}" },
      "borderStrong": { "$type": "color", "$value": "{color.gray.200}" },
      "accent": { "$type": "color", "$value": "{color.brand.500}" },
      "accentHover": { "$type": "color", "$value": "{color.brand.600}" },
      "ai": { "$type": "color", "$value": "{color.brand.500}", "$description": "AI-generated content" },
      "human": { "$type": "color", "$value": "{color.info.500}", "$description": "Human input / review" },
      "outcome": { "$type": "color", "$value": "{color.success.500}", "$description": "Final, approved result" },
      "focusRing": { "$type": "color", "$value": "rgba(80, 70, 229, 0.35)", "$extensions": { "guess": true } }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "7": { "$type": "dimension", "$value": "30px" },
    "8": { "$type": "dimension", "$value": "40px" },
    "9": { "$type": "dimension", "$value": "50px" },
    "10": { "$type": "dimension", "$value": "60px" },
    "12": { "$type": "dimension", "$value": "80px" },
    "14": { "$type": "dimension", "$value": "100px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "lg": { "$type": "dimension", "$value": "8px" },
    "pill": { "$type": "dimension", "$value": "999px" },
    "full": { "$type": "dimension", "$value": "50%" }
  },
  "shadow": {
    "xs": { "$type": "shadow", "$value": "0 1px 2px rgba(0, 0, 0, 0.05)" },
    "sm": { "$type": "shadow", "$value": "0 1px 3px rgba(0, 0, 0, 0.05)" },
    "md": { "$type": "shadow", "$value": "0 5px 15px rgba(0, 0, 0, 0.05)" },
    "lg": { "$type": "shadow", "$value": "0 10px 20px rgba(0, 0, 0, 0.05)" }
  },
  "motion": {
    "duration": { "fast": { "$type": "duration", "$value": "200ms" }, "base": { "$type": "duration", "$value": "300ms" } },
    "easing": { "standard": { "$type": "cubicBezier", "$value": "ease" } }
  },
  "layout": {
    "containerMax": { "$type": "dimension", "$value": "1200px" },
    "containerNarrow": { "$type": "dimension", "$value": "1000px" },
    "proseMax": { "$type": "dimension", "$value": "600px" },
    "gutter": { "$type": "dimension", "$value": "20px" },
    "breakpointMd": { "$type": "dimension", "$value": "768px" }
  }
}
