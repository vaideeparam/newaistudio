# Copy to .env (never commit .env). With nothing set, `npm run dev` runs in mock mode.

# ai/Studio dev MCP (full API, Streamable HTTP, OAuth with PKCE + dynamic client registration).
# Enterprise MCP: https://dev.paramai.studio/enterprise/mcp
STUDIO_MCP_URL=https://dev.paramai.studio/gwapi/mcp

# Auth mode is picked automatically:
#   STUDIO_MCP_MOCK=1        -> canned data, no Gateway calls
#   STUDIO_MCP_TOKEN=...     -> one shared bearer token for the whole server (local dev only)
#   otherwise                -> per-user OAuth against the Gateway (production)
STUDIO_MCP_MOCK=
STUDIO_MCP_TOKEN=

# OAuth extras, only if the Gateway needs them (otherwise dynamic client registration is used)
STUDIO_MCP_SCOPE=mcp
STUDIO_MCP_CLIENT_ID=
STUDIO_MCP_CLIENT_SECRET=

# Public origin of the app, used for the OAuth redirect (/api/auth/callback)
PUBLIC_URL=http://localhost:5173
PORT=8787
SESSION_TTL_HOURS=12
